ECERT_SMTP_PASSWORD=<SMTP_PASSWORD>
ECERT_ALLOWED_ORIGIN=https://www.e-certificate.com.my
ECERT_SMTP_MODE=starttls
ECERT_RATE_LIMIT_DIR=/home/account/private/ecert-contact-rate-limit
# Alternative protected credential file, outside the public document root:
# ECERT_CONTACT_CONFIG=/home/account/private/contact.php
