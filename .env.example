# Environment variables override the private settings file key by key; leave them
# unset on cPanel. ECERT_ALLOWED_ORIGIN takes a comma-separated list.
ECERT_SMTP_PASSWORD=<SMTP_PASSWORD>
ECERT_ALLOWED_ORIGIN=https://www.e-certificate.com.my,https://e-certificate.com.my
ECERT_SMTP_MODE=starttls
ECERT_RATE_LIMIT_DIR=/home/kflegacy/private/ecert-contact-rate-limit
# Private settings file outside the public document root (template: config/contact.example.php).
# Default when unset: /home/kflegacy/private/e-certificate-web.php (file 600, directory 700).
# ECERT_CONTACT_CONFIG=/home/kflegacy/private/e-certificate-web.php
# Origin of the e-Certificate app whose public API the Verify, Pricing and Checkout pages call (scheme://host[:port], no path):
ECERT_APP_URL=https://apps.e-certificate.com.my
# Optional: directory for the 120 s packages cache (default: <system temp>/ecert-web-cache).
# ECERT_CACHE_DIR=/tmp/ecert-web-cache
# Optional Google Search Console token (HTML tag method); the content value only, not the whole tag.
# Unset means no verification meta tag is printed. The private settings file key is google_site_verification.
# ECERT_GOOGLE_SITE_VERIFICATION=
# Optional SMTP overrides for the Contact form (defaults indigo.herosite.pro and 587); for a local SMTP sink only.
# ECERT_SMTP_HOST=127.0.0.1
# ECERT_SMTP_PORT=2525
